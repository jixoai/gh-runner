{
  "name": "@jixoai/gh-runner",
  "version": "0.2.15",
  "description": "Manage multiple GitHub Actions self-hosted runners with a macOS/Windows tray app or Linux headless CLI: discover, register, start/stop, and analyze job results.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jixoai/gh-runner.git"
  },
  "bugs": {
    "url": "https://github.com/jixoai/gh-runner/issues"
  },
  "homepage": "https://github.com/jixoai/gh-runner#readme",
  "keywords": [
    "github-actions",
    "self-hosted-runner",
    "tray",
    "menubar",
    "runner-fleet"
  ],
  "bin": {
    "gh-runner": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "tsdown && vite build && node scripts/sync-assets.mjs",
    "start": "node dist/main.mjs",
    "dev": "pnpm build && node dist/main.mjs --dry-run 4",
    "smoke": "pnpm build && node dist/main.mjs --smoke",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "ui-dev": "vite build --watch",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@opentray/ext-clipboard": "^0.36.2",
    "@opentray/ext-dialog": "^0.36.2",
    "@opentray/ext-opener": "^0.36.2",
    "@opentray/ext-webview": "^0.36.2",
    "@opentray/icon": "^0.36.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next-themes": "^0.4.6",
    "opentray": "^0.36.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-glass": "^0.0.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
