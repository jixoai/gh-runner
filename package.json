{
  "name": "runner-fleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tray tool for managing multiple GitHub Actions self-hosted runners on one Mac",
  "scripts": {
    "build": "tsdown && mkdir -p dist/ui && cp src/ui/index.html src/ui/demo.js dist/ui/",
    "start": "node dist/main.mjs",
    "dev": "pnpm build && node dist/main.mjs --dry-run 4",
    "smoke": "pnpm build && node dist/main.mjs --smoke",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentray/ext-dialog": "^0.36.0",
    "@opentray/ext-webview": "^0.36.0",
    "opentray": "^0.36.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
